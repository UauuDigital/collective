# index.html + data.json: always revalidate with server (no stale cache)
<FilesMatch "^(index\.html|data\.json)$">
  Header set Cache-Control "no-cache, must-revalidate"
  Header unset ETag
  FileETag MTime Size
</FilesMatch>

# Static assets: cache aggressively (fonts, logos, etc.)
<FilesMatch "\.(woff2?|ttf|otf|png|jpg|webp|svg|ico)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
